# Copy to .env. Never commit real keys.
# Open-weights model behind any OpenAI-compatible endpoint (e.g. a vLLM/Ollama server or a hosted provider).
# Leave LLM_BASE_URL/LLM_MODEL empty to run in the labelled OFFLINE STUB mode (no model).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DATABASE_URL=sqlite:///data/agrireach.db
# Third-party fetch MCP server options. Add --allow-private-ips only if your DNS resolves public hosts to private IPs.
FETCH_MCP_ARGS=
AGRIREACH_SOURCE_CHECK=1
# Optional judge model for the claim check (off when empty). Uses LLM_BASE_URL/LLM_API_KEY unless set below.
AGRIREACH_JUDGE_MODEL=
AGRIREACH_JUDGE_BASE_URL=
AGRIREACH_JUDGE_API_KEY=
# Voice notes (local; see docs/voice-channel.md). Needs: pip install -r requirements-voice.txt
AGRIREACH_STT=faster-whisper
AGRIREACH_STT_MODEL=base
AGRIREACH_TTS=
# First-contact consent prompt (1 = on) and how long sender numbers and voice notes are kept
# Local phone simulator (lists every farmer's messages, no sign-in): demo machines only, never on a server.
# AGRIREACH_SIMULATOR=1   # local demo only: opens the farmer simulator routes with no auth. Never set in production.
AGRIREACH_CONSENT=1
AGRIREACH_RETENTION_DAYS=90
# WhatsApp Cloud API adapter: code only, off by default (docs/whatsapp-setup.md). Never commit real values.
WHATSAPP_ENABLED=0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# SMS via Africa's Talking: code only, no account, never sent a real SMS, off by default (docs/sms-setup.md).
# Never commit real values. AT_SANDBOX=1 needs AT_USERNAME=sandbox. SMS_WEBHOOK_TOKEN: 20+ random characters.
SMS_ENABLED=0
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=1
SMS_WEBHOOK_TOKEN=
SMS_MAX_SEGMENTS=4

# Rainfall record for planting questions (src/agrireach/rainfall.py): open-meteo (default) | off | fixture:<dir>
# Open-Meteo data is CC BY 4.0; its free API is for non-commercial use only.
AGRIREACH_RAINFALL=open-meteo
# Optional NASA POWER cross-check (MERRA2-only responses, days >= 7 days old): set to nasa_power to enable
AGRIREACH_RAINFALL_CROSSCHECK=
